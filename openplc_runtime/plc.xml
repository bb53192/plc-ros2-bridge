            </variable>
          </outputVars>
          <localVars>
            <variable name="blink_timer">
              <type>
                <derived name="TON"/>
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml:p><![CDATA[blink_timer(IN := enable AND NOT blink_timer.Q, PT := T#500ms);

IF enable THEN
    IF blink_timer.Q THEN
        blink_out := NOT blink_out;
    END_IF;
ELSE
    blink_out := FALSE;
    blink_timer(IN := FALSE, PT := T#500ms);
END_IF;]]></xhtml:p>
          </ST>
        </body>
